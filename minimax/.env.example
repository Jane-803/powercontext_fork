# MiniMax Anthropic-compatible API. Never commit the real token.
MINIMAX_API_KEY=<your-minimax-token-plan-key>
MINIMAX_MODEL=MiniMax-M3.1-Flash
MINIMAX_API_FORMAT=openai
MINIMAX_BASE_URL=https://api.minimax.chat/v1

# PowerContext 1.2.0 server started from this directory.
POWERCONTEXT_URL=http://127.0.0.1:8000
POWERCONTEXT_SCOPE_KEY=minimax-sdd-filter-v1

# Omit SEEKDB_HOST for embedded seekdb on Linux/macOS.
# SEEKDB_HOST=127.0.0.1
# SEEKDB_PORT=2881
# SEEKDB_TENANT=sys
# SEEKDB_DATABASE=test
# SEEKDB_USER=root
# SEEKDB_PASSWORD=<password>
